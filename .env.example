# ===== V_COM Server Environment =====
NODE_ENV=development
PORT=5000
APP_NAME=V_COM

# Frontend / app origins allowed to call this API (comma separated)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=vcom_db

# ===== JWT =====
JWT_SECRET=change_this_to_a_long_random_string_64_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Uploads =====
MAX_UPLOAD_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50

# ===== URL =====
API_BASE_URL=http://localhost:5000
PUBLIC_FILE_BASE_URL=http://localhost:5000/uploads
# ===== Cloudinary (service category/service images) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=v-com

# ===== SMS / OTP (app phone login) =====
# mock = fixed OTP + console log (dev/test). Switch to msg91/twilio when keys are set.
SMS_PROVIDER=mock
OTP_FIXED_CODE=123456
OTP_TTL_MINUTES=5
# Rate limits (0 = unlimited). Defaults: production 5/day,1/min per phone,3/min per IP; dev unlimited per phone,30/min per IP.
# OTP_DAILY_LIMIT=0
# OTP_PHONE_PER_MINUTE=0
# OTP_SEND_PER_MINUTE=30
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
